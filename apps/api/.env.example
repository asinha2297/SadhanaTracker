# Copy to apps/api/.env and fill in. .env is git-ignored; never commit real secrets.
# Variables already set in the environment (by your host, Docker, CI) take precedence over this file.

# development | production | test. Left unset, the API assumes production.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Signs session cookies. Required; at least 32 random characters. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Database. Leave DATABASE_URL empty to use the embedded PGlite in PGLITE_DIR,
# or point it at PostgreSQL, e.g. postgres://user:password@host:5432/sadhana?sslmode=require
DATABASE_URL=
PGLITE_DIR=./data/sadhana

# Cookies get the Secure flag automatically outside development; force it with true/false.
# COOKIE_SECURE=true

# Behind a reverse proxy (nginx, a load balancer, Render, Fly…): number of proxies in front
# of the API, or a list such as "loopback, 10.0.0.0/8". Leave false when clients connect directly,
# otherwise anyone can spoof their address past the rate limits.
TRUST_PROXY=false

# Production: serve the built web app from this folder (npm start sets it).
# WEB_DIST=../web/dist

# First start on an empty database only: creates administrator SH-0001, who signs in with
# this mobile number and temporary password and must change it. Remove both afterwards.
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_PASSWORD=

# npm run seed refuses to plant the demo accounts (known passwords) into DATABASE_URL
# unless this is true. It always refuses in production.
ALLOW_DEMO_SEED=false

# /etc/sadhana/env — the production settings systemd hands to the API (root:sadhana, mode 0640).
# install.sh writes this file once, with generated secrets; afterwards it is yours to edit.
# Restart after changes: sudo systemctl restart sadhana
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Signs session cookies; changing it signs everyone out. install.sh generates it (openssl rand -base64 48).
SESSION_SECRET=

# PostgreSQL on this machine (install.sh creates the role and database), or leave empty to use the embedded
# PGlite database in /var/lib/sadhana/pglite.
DATABASE_URL=postgres://sadhana:PASSWORD@127.0.0.1:5432/sadhana

# Caddy is the one proxy in front of the API.
TRUST_PROXY=1

# Off-site copies of the nightly backup: an OCI Object Storage pre-authenticated request URL for the bucket
# (permit object writes). backup.sh PUTs each file to this URL. Leave empty to keep local copies only.
# BACKUP_UPLOAD_URL=https://objectstorage.ap-mumbai-1.oraclecloud.com/p/.../n/.../b/sadhana-backups/o/
